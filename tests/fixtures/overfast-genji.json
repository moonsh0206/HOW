{"name":"\uac90\uc9c0","description":"\uc0ac\uc774\ubcf4\uadf8 \uc2dc\ub9c8\ub2e4 \uac90\uc9c0\ub294 \ud55c\ub54c \uac70\ubd80\ud588\ub358 \uc790\uc2e0\uc758 \ub85c\ubd07 \uc721\uccb4\ub97c \ubc1b\uc544\ub4e4\uc600\uc73c\uba70, \uadf8 \uacfc\uc815\uc5d0\uc11c \ud55c \ucc28\uc6d0 \ub354 \ub192\uc740 \uc778\uac04\uc131\uc744 \uac16\uac8c \ub418\uc5c8\uc2b5\ub2c8\ub2e4.","backgrounds":[{"url":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/blt662cec43713c06e7/631a8b57a0ff920e11e791c0/960_Genji.jpg","sizes":["min","xs","sm"]},{"url":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/blt22836a6cfd1c3335/631a8b576d5f7a0df8d92798/1600_Genji.jpg","sizes":["md","lg"]},{"url":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/bltb6d5cb702c3e2476/631a8b57e7bdcf0dd996c8dd/2600_Genji.jpg","sizes":["xl+"]}],"portrait":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/156b12c20b1aea872c1eeb5bb37a7de1047b2ab30ecefd0663a8925badde1ea8.png","role":"damage","subrole":"flanker","location":"\uc77c\ubcf8, \ud558\ub098\ubb34\ub77c(\uc774\uc804 \uae30\ub85d), \ub124\ud314, \uc0f4\ubc1c\ub9ac \uc218\ub3c4\uc6d0(\uc774\uc804 \uae30\ub85d), \uac10\uc2dc \uae30\uc9c0: \uc9c0\ube0c\ub864\ud130","birthday":"10\uc6d4 28\uc77c","age":37,"hitpoints":{"shields":0,"armor":0,"health":250,"total":250},"abilities":[{"name":"\uc218\ub9ac\uac80","description":"\ud22c\uc0ac\uccb4 3\uac1c\ub97c \uc5f0\ub2ec\uc544 \ub358\uc9d1\ub2c8\ub2e4.  \ud22c\uc0ac\uccb4 3\uac1c\ub97c \ubd80\ucc44\uaf34\ub85c \ub358\uc9d1\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/75fe50db5b246e9786632963f6e1126029bd270bfaaa8b9f564e303a9b938906.png","video":{"thumbnail":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/blt2ffbd1e3f3d91182/633905b7b8dbde69f5279908/GENJI_Shuriken.jpg","link":{"mp4":"https://blz-contentstack-assets.akamaized.net/v3/assets/blt2477dcaf4ebd440c/bltd0e67eec15977faa/633905b22dc763