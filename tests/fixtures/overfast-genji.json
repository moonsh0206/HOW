0p30_WEBM.webm"}}}],"perks":{"minor":[{"name":"\uc2e0\uc18d \ubca0\uae30","description":"\ube60\ub978 \uadfc\uc811 \uacf5\uaca9 \uc2dc \uc9c8\ud48d\ucc38\uc758 \uc7ac\uc0ac\uc6a9 \ub300\uae30\uc2dc\uac04\uc774 3\ucd08 \uac10\uc18c\ud569\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/72c205ea67dbe8dad29066f1b63b9377fe269eb134a2d58c203c16ed9e641f0c.png"},{"name":"\uc6a9\uc758 \uac08\uc99d","description":"\uc6a9\uac80\uc744 \ud718\ub450\ub974\uba74 \uc0dd\uba85\ub825 \ud761\uc218\ub97c 30% \uc5bb\uc2b5\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/8eaca93d060776d4d3204338656e0aaad85afeeae516d21e47ccfc91aae4efde.png"}],"major":[{"name":"\ud68c\uc804\ud558\ub294 \uce7c\ub0a0","description":"\uc801\uc758 \uc0dd\uba85\ub825\uc774 \uc808\ubc18 \ubbf8\ub9cc\uc774\ub77c\uba74 \uc9c8\ud48d\ucc38\uc774 25\uc758 \ucd94\uac00 \uc9c0\uc18d \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/abcef6f42d1803faa1442b14f351ba1165f93c993e8530145d165e43419dda1d.png"},{"name":"\uba85\uc0c1","description":"\ud295\uaca8\ub0b4\uae30\uac00 \ud65c\uc131\ud654\ub418\uc5b4 \uc788\ub294 \ub3d9\uc548 \uc0dd\uba85\ub825\uc744 \ucd08\ub2f9 50\uc529 \ud68c\ubcf5\ud569\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/f6046ca3bc6b1dde0cece4f255b2e30eba0ef50aecff6ecfbe3858b0ee7cc4c2.png"}]},"story":{"summary":"\ub2cc\uc790 \uac90\uc9c0 \uc2dc\ub9c8\ub2e4\ub294 \uce5c\ud615\uc5d0\uac8c \uc8fd\uc744 \uc704\uae30\ub97c \ub118\uae30\uace0 \uc624\ubc84\uc6cc\uce58\uc5d0 \uc758\ud574 \uad6c\uc870\ub418\uc5c8\ub2e4. \uc624\ubc84\uc6cc\uce58\ub294 \uac90\uc9c0\ub97c \uc0b4\ub9ac\uae30 \uc704\ud574 \uadf8\uc758 \uc2e0\uccb4\ub97c \uc0ac\uc774\ubcf4\uadf8\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \uadf8\ub97c \uc0b4\uc544 \uc788\ub294 \ubb34\uae30\ub85c \ub9cc\ub4e4\uc5c8\ub2e4. \uc624\ubc84\uc6cc\uce58 \ubab0\ub77d \uc774\ud6c4 \uc790\uc2e0\uc758 \ubcf8\uc9c8\uacfc \ubaa9\uc801\uc5d0 \ub300\ud574 \uace0\ub1cc\ud558\ub358 \uac90\uc9c0\ub294 \uc634\ub2c9 \uc218\ub3c4\uc0ac \uc820\uc57c\ud0c0\uc640 \uc218\ub828\ud558\uba70 \ub9c8\uc74c\uc758 \ud3c9\ud654\ub97c \ucc3e\uc558\uace0, \uc774\ud6c4 \uc708\uc2a4\ud134\uc758 \uc18c\uc9d1\uc5d0 \uc751\ub2f5\ud558\uac8c \ub41c\ub2e4.","media":{"type":"video","link":"https://youtu.be/oJ09xdxzIJQ"},"chapters":[{"title":"\uc2dc\ub9c8\ub2e4 \uc77c\uc871","content":"\uc2dc\ub9c8\ub2e4 \uc77c\uc871 \uc218\uc7a5\uc758 \ub9c9\ub0b4\uc544\ub4e4\uc778 \uac90\uc9c0\ub294 \uac80\uc220\uacfc \ud568\uaed8 \uc131\uc7a5\ud588\ub2e4.\uadf8\ub294 \uac80\uc131 \uc57c\ub9c8\uac00\ubbf8 \uc544\uc0ac \ud718\ud558\uc5d0\uc11c \ud6c8\ub828\ud558\uba74\uc11c \uadf8\ub140\uc758 \ub538 \ud0a4\ub9ac\ucf54\uc640 \uce5c\ud574\uc84c\ub2e4. \uac90\uc9c0\ub294 \ud0c1\uc6d4\ud55c \uc7ac\ub2a5\uc744 \ubcf4\uc774\uba70 \ub2cc\uc790 \ud6c8\ub828\uc744 \uc990\uacbc\uc9c0\ub9cc \uac00\ubb38\uc758 \ubd88\ubc95\uc801\uc778 \uc0ac\uc5c5\uc5d0\ub294 \uad00\uc2ec\uc774 \uc5c6\uc5c8\uace0, \ud55c\ub7c9 \uac19\uc740 \uc0b6\uc744 \ucd94\uad6c\ud558\uba70 \ub300\ubd80\ubd84\uc758 \uc2dc\uac04\uc744 \ubcf4\ub0c8\ub2e4. \uc77c\uc871\uc758 \ub9ce\uc740 \uc0ac\ub78c\ub4e4\uc740 \ubb34\ucc45\uc784\ud55c \uac90\uc9c0\uac00 \uc870\uc9c1\uc758 \uc704\ud5d8 \uc694\uc18c\ub77c\uba70 \uace8\uce6b\uac70\ub9ac\ub85c \uc5ec\uacbc\uace0, \uc544\ub4e4\uc744 \uc560\uc9c0\uc911\uc9c0\ud558\uba70 \uac10\uc2f8\ub294 \uc544\ubc84\uc9c0\ub97c \ubabb\ub9c8\ub545\ud574 \ud588\ub2e4. \uadf8\ub7ec\ub358 \uc5b4\ub290 \ub0a0 \uc77c\uc871\uc758 \uc218\uc7a5\uc774 \uac11\uc790\uae30 \uc0ac\ub9dd\ud558\uace0, \uac90\uc9c0\uc758 \ud615 \ud55c\uc870\ub294 \uac90\uc9c0\uc5d0\uac8c \uc120\uce5c\uc758 \uc81c\uad6d\uc5d0\uc11c \uc870\uae08 \ub354 \uc801\uadf9\uc801\uc778 \uc5ed\ud560\uc744 \ub9e1\uc544 \uc904 \uac83\uc744 \uc694\uad6c\ud588\ub2e4. \ud558\uc9c0\ub9cc \uac90\uc9c0\ub294 \uc774\ub97c \uac70\uc808\ud588\uace0, \ud55c\uc870\ub294 \ud654\ub97c \ub0c8\ub2e4. \ud615\uc81c \uc0ac\uc774\uc5d0 \uae34\uc7a5\uac10\uc774 \uace0\uc870\ub418\uc5c8\uace0, \uacb0\uad6d \uaca9\ub82c\ud55c \uc2f8\uc6c0\uc774 \ubc8c\uc5b4\uc9c4 \uacb0\uacfc \uac90\uc9c0\ub294 \ube48\uc0ac \uc0c1\ud0dc\uc5d0 \ube60\uc9c0\uace0 \ub9d0\uc558\ub2e4.","picture":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/bltb983c9c07c5e404e/637da16446a48b0e063e4a95/genji-00.jpg"},{"title":"\ube14\ub799\uc6cc\uce58","content":"\ud55c\uc870\ub294 \uc790\uc2e0\uc758 \uc190\uc73c\ub85c \ub3d9\uc0dd\uc744 \uc8fd\uc600\ub2e4\uace0 \ubbff\uc5c8\uc73c\ub098, \uac90\uc9c0\ub294 \uc8fd\uae30 \uc9c1\uc804 \uc624\ubc84\uc6cc\uce58 \uc18c\uc18d\uc758 \uc559\uac94\ub77c \uce58\uae00\ub7ec \ubc15\uc0ac\uc5d0\uac8c \uad6c\uc870\ub41c\ub2e4. \ud55c\ub54c \uc138\uacc4\ub97c \uc9c0\ucf30\ub358 \ubc29\uc704\uad70\uc740 \uacc4\uc18d\ub418\ub294 \uc2dc\ub9c8\ub2e4 \uc77c\uc871\uacfc\uc758 \uc804\ud22c \uc791\uc804\uc5d0\uc11c \uac90\uc9c0\uac00 \uc7a0\uc7ac\uc801\uc778 \uc790\uc0b0\uc774 \ub420 \uac70\ub77c\uace0 \ud310\ub2e8\ud588\ub2e4. \ubd80\uc0c1\uc73c\ub85c \uc778\ud574 \uac90\uc9c0\uc758 \ubaa9\uc228\uc740 \uc704\ud0dc\ub85c\uc6b4 \uc0c1\ud669\uc774\uc5c8\uae30 \ub54c\ubb38\uc5d0, \uc624\ubc84\uc6cc\uce58\ub294 \uadf8\uc758 \uc721\uccb4\ub97c \uc7ac\uac74\ud574 \uc8fc\ub294 \ub300\uac00\ub85c \uadf8\uc758 \ud611\ub825\uc744 \uc694\uad6c\ud588\ub2e4. \uadf8\ub294 \uad11\ubc94\uc704\ud55c \uc0ac\uc774\ubc84\ud654\ub97c \uac70\ucce4\uace0, \uadf8 \ub355\ubd84\uc5d0 \ud0c0\uace0\ub09c \uc18d\ub3c4\uc640 \ubbfc\ucca9\uc131, \ucd5c\uc0c1\uae09\uc758 \ub2cc\uc790 \uae30\uc220\uc774 \ub300\ud3ed \uac15\ud654\ub418\uc5c8\ub2e4. \uc0b4\uc544 \uc788\ub294 \ubb34\uae30\ub85c \ubcc0\ud55c \uac90\uc9c0\ub294 \ube14\ub799\uc6cc\uce58\uc5d0 \ud569\ub958\ud558\uc5ec \ub9f9\ubaa9\uc801\uc73c\ub85c \uac00\ubb38\uc758 \ubc94\uc8c4 \uc81c\uad6d\uc744 \ud574\uccb4\ud558\ub294 \uc77c\uc5d0 \uc804\ub150\ud588\ub2e4. \uc774 \uc784\ubb34\uac00 \uc644\ub8cc\ub418\uc5c8\uc744 \ub54c, \uadf8\ub294 \ud6e8\uc52c \ub354 \ubcf5\uc7a1\ud55c \uc784\ubb34\ub97c \ub9e1\uc558\uace0, \uc545\uba85 \ub192\uc740 \ubca0\ub124\uce58\uc544 \uc0ac\uac74\uc5d0\ub3c4 \uad00\uc5ec\ud588\ub2e4. \uc774 \uc0ac\uac74\uc73c\ub85c \uc778\ud574 \ube14\ub799\uc6cc\uce58\uc758 \uc874\uc7ac\uac00 \uc138\uc0c1\uc5d0 \ub4dc\ub7ec\ub0ac\uace0, \uc774 \ud300\uc758 \uc6b4\uc601\uc774 \uc911\ub2e8\ub418\uac8c \ub418\uc5c8\ub2e4.","picture":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/blt9fef564c18fa9a73/637da165bbfd340e8ad2e2fc/genji-01.jpg"},{"title":"\uc624\ubc84\uc6cc\uce58","content":"\ud558\uc9c0\ub9cc \uac90\uc9c0\ub294 \uc624\ub7ab\ub3d9\uc548 \uc740\ub454\ud558\uc9c0\ub294 \uc54a\uc558\ub2e4. \uc624\ubc84\uc6cc\uce58 \uc9c0\ub3c4\ubd80\ub294 \uac90\uc9c0\uac00 \ub354 \ud070 \uaddc\ubaa8\uc758 \uc624\ubc84\uc6cc\uce58 \ud0c0\uaca9\ud300\uc5d0 \ud569\ub958\ud560 \uc218 \uc788\ub3c4\ub85d \uc694\uc6d0 \ud6c8\ub828\uc744 \uacc4\uc18d\ud558\uac8c \ud588\uace0, \uadf8\ub294 \ud2b8\ub808\uc774\uc11c \ubc0f \uc708\uc2a4\ud134\uacfc \ud568\uaed8 \uc878\uc5c5\ud588\ub2e4. \ud558\ubc14\ub098\uc640 \uc2f1\uac00\ud3ec\ub974\uc5d0\uc11c\uc758 \ud65c\uc57d \ub355\ubd84\uc5d0 \uac90\uc9c0\uc640 \uadf8\uc758 \ubd80\ub300\uc6d0\ub4e4\uc740 \ub460\ud53c\uc2a4\ud2b8\ub97c \uccb4\ud3ec\ud560 \uc218 \uc788\uc5c8\uace0, \uadf8 \ud6c4\uc5d0\ub3c4 \uc624\ubc84\uc6cc\uce58\uc758 \ud604\uc0c1 \uc218\ubc30 \uba85\ub2e8 \ucd5c\uc0c1\ub2e8\uc5d0 \uc788\ub294 \uc778\ubb3c\ub4e4\uc744 \ucc28\ub840\ucc28\ub840 \uad6c\uc18d\ud588\ub2e4. \ud558\uc9c0\ub9cc \uc624\ubc84\uc6cc\uce58\uac00 \ubab0\ub77d\ud588\uc744 \ub54c, \uac90\uc9c0\ub294 \ud558\ub098\ubb34\ub77c\uc5d0\uc11c\uc758 \uc6b4\uba85\uc758 \ubc24\uc73c\ub85c\ubd80\ud130 \uc624\ubc84\uc6cc\uce58 \uc694\uc6d0\uc73c\ub85c \uc0b4\uc544\uac00\ub294 \uc9c0\uae08\uc5d0 \uc774\ub974\uae30\uae4c\uc9c0 \uc77c\uc5b4\ub0ac\ub358 \ubaa8\ub4e0 \uc77c\ub4e4\uc744 \ub5a0\uc62c\ub9ac\uba70 \uc790\uc2e0\uacfc\uc758 \uc804\uc7c1\uc5d0 \ube60\uc838\ub4e4\uc5c8\ub2e4. \uadf8\ub7ec\ub2e4 \uacb0\uad6d \ub450 \ubc88\uc9f8\ub85c \uc774\uc804\uc758 \uc0b6\uc744 \ud3ec\uae30\ud558\uace0 \uc758\ubbf8\ub97c \ucc3e\uc544 \uc138\uacc4\ub97c \ub5a0\ub3cc\uc558\ub2e4. \uadf8\ub9ac\uace0 \uc624\ub7ab\ub3d9\uc548 \ubc29\ud669\ud55c \ud6c4, \uc634\ub2c9 \uc218\ub3c4\uc0ac \uc820\uc57c\ud0c0\ub97c \ub9cc\ub0ac\ub2e4.\uc2dc\uac04\uc774 \ud758\ub7ec \uc820\uc57c\ud0c0\ub294 \uadf8\uc758 \uc2a4\uc2b9\uc774 \ub418\uc5c8\uace0, \uc218\ub3c4\uc0ac\uc758 \uac00\ub974\uce68\uc5d0 \ub530\ub77c \uac90\uc9c0\ub294 \uc790\uc2e0\uc758 \uacbd\ud5d8\uacfc \uc0ac\uc774\ubcf4\uadf8 \uc2e0\uccb4\uac00 \ucd95\ubcf5\uc774\uba70 \uc790\uc2e0\ub9cc\uc774 \uc9c0\ub2cc \ub2a5\ub825\uc774\ub77c\uace0 \uc0dd\uac01\ud558\uae30 \uc2dc\uc791\ud588\ub2e4. \uc2dc\ub9c8\ub2e4 \ud615\uc81c\ub294 \uc774\ud6c4 \uac90\uc9c0\uc758 \uae30\uc77c\uc5d0 \ub2e4\uc2dc \ub9cc\ub0ac\ub2e4. \uc774\uc81c\ub294 \ud558\uc2dc\ubaa8\ud1a0 \uc77c\uc871\uc758  \uc218\uc911\uc5d0 \ub4e4\uc5b4\uac04 \uc2dc\ub9c8\ub2e4 \uc131\uc758 \uc608\uc804 \uc9d1\uc5d0\uc11c, \uac90\uc9c0\ub294 \uc774\uc804 \uc6b4\uba85\uc758 \uc804\ud22c\uc5d0\uc11c \uc790\uc2e0\uc774 \uc0b4\uc544\ub0a8\uc558\ub2e4\ub294 \uc0ac\uc2e4\uc744 \ubc1d\ud614\ub2e4. \uac90\uc9c0\ub294 \uc790\uae30\ub294 \uc774\ubbf8 \ud615\uc744 \uc6a9\uc11c\ud588\uc9c0\ub9cc, \uc774\uc81c \ud55c\uc870\ub3c4 \uc790\uae30 \uc790\uc2e0\uc744 \uc6a9\uc11c\ud558\ub294 \uae38\uc744 \uac78\uc5b4\uc57c \ud55c\ub2e4\uace0 \uc774\uc57c\uae30\ud588\ub2e4. \uc774\uc81c \uc790\uae30 \uc6b4\uba85\uc758 \uc8fc\uc778\uc774 \ub41c \uac90\uc9c0\ub294 \ud55c \ubc88 \ub354 \uc624\ubc84\uc6cc\uce58\ub97c \ub3d5\uae30\ub85c \ud558\uace0, \uc61b \ub3d9\ub8cc \ubc0f \uc0c8\ub86d\uac8c \ud569\ub958\ud55c \uc774\ub4e4\uacfc \ud568\uaed8 \uc704\uae30\uc5d0 \ud729\uc2f8\uc778 \uc138\uacc4\ub97c \uc9c0\uc6d0\ud558\uae30 \uc704\ud574 \ub3cc\uc544\uc654\ub2e4.","picture":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/bltc878fc10bd8ab2cb/63880951443fa70e71d4bfc5/genji-02.jpg"},{"title":"\ud0c8\ub860\uc758 \uc9c0\ubc30","content":"\uac00\uc871\uacfc \uace0\ud5a5\uc774 \uc704\ud5d8\uc5d0 \ucc98\ud55c \uac83\uc744 \ubcf8 \uac90\uc9c0\ub294 \uc810\ucc28 \ucee4\uc9c0\ub294 \ud558\uc2dc\ubaa8\ud1a0\uc758 \uc704\ud611\uc5d0 \ub9de\uc11c\uae30 \uc704\ud574 \ub3c4\ucfc4\ub85c \ud5a5\ud588\uc2b5\ub2c8\ub2e4. \uadf8\ub294 \ubc30\ud6c4\uc5d0\uc11c \ud0c8\ub860\uc774 \ud798\uc744 \ube4c\ub824\uc8fc\uace0 \uc788\ub2e4\ub294 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub418\uc790, \uc801\uc5d0\uac8c \uc77c\ubd80\ub7ec \uc0ac\ub85c\uc7a1\ud600 \ud55c\uc870\uc640 \ud0a4\ub9ac\ucf54\uac00 \ud0c8\ucd9c\ud560 \uc218 \uc788\ub3c4\ub85d \uc790\uc2e0\uc744 \ud76c\uc0dd\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uad81\uadf9\uc801\uc73c\ub85c \uadf8\ub97c \uad6c\ucd9c\ud558\uae30 \uc704\ud574 \uc624\ubc84\uc6cc\uce58\uac00 \ud30c\uacac\ub418\ub294 \uacb0\uacfc\ub85c \uc774\uc5b4\uc84c\uc2b5\ub2c8\ub2e4. \ub9c8\uce68\ub0b4 \ud480\ub824\ub09c \uac90\uc9c0\ub294 \uc9c0\uae08\uae4c\uc9c0\uc758 \uc5ec\uc815 \uc18d\uc5d0\uc11c \uc790\uc2e0\uc774 \uace0\ud5a5\uacfc \uac00\uc871\uc5d0\uac8c\uc11c \ub108\ubb34 \uba40\ub9ac \ub5a0\ub098\uc640 \uc788\uc5c8\ub2e4\ub294 \uac83\uc744 \uae68\ub2ec\uc558\uc2b5\ub2c8\ub2e4. \uac00\uc871\uc5d0 \ub300\ud55c \ud5cc\uc2e0\uc744 \uc0c8\ub85c\uc774 \ub2e4\uc9d0\ud55c \uadf8\ub294 \ub2f9\ubd84\uac04 \uc624\ubc84\uc6cc\uce58\uc5d0\uc11c \ub5a0\ub098, \ud55c\uc870\uc640 \ud0a4\ub9ac\ucf54\uc758 \uacc1\uc5d0\uc11c \ub3c4\ucfc4\ub97c \uc7ac\uac74\ud558\uace0 \ud558\uc2dc\ubaa8\ud1a0\ub97c \ub9c9\ub294 \uc77c\uc744 \ub3d5\uae30\ub85c \ub9c8\uc74c\uba39\uc2b5\ub2c8\ub2e4.","picture":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/bltf8ebeac5659e26aa/69864239e7959c7b85bb36a9/talon_lore.png"}]},"stadium_powers":[{"name":"\uc2e0\uc131\ud55c \uc218\ub9ac\uac80","description":"\uc218\ub9ac\uac80 \uae30\ubcf8 \ubc1c\uc0ac \ud22c\uc0ac\uccb4 \uc18d\ub3c4 +50%\u00ad\u00a0\uc218\ub9ac\uac80 \uae30\ubcf8 \ubc1c\uc0ac \uc2dc \ud0c4\uc57d\uc744 \uc18c\ubaa8\ud558\uc9c0 \uc54a\ub294 \uc218\ub9ac\uac80\uc744 2\uac1c \ucd94\uac00\ub85c \ub358\uc9d1\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/ff58ae37ebc99a62deb1f919250d2d70fdee6d1a0a3d07a81465b33817667ec6.png"},{"name":"\ud558\ub098\ubb34\ub77c \uce58\uc720","description":"\uce58\uba85\ud0c0\uc640 \uc9c8\ud48d\ucc38\uc73c\ub85c \uc900 \ud53c\ud574\uc758 25%\uc5d0 \ud574\ub2f9\ud558\ub294 \ucd94\uac00 \uc0dd\uba85\ub825\uc744 \uc5bb\uc2b5\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/1c6988e458c07ce31ecc2206503ef329c1845c59ab6bf41b593e1b1e85da9f49.png"},{"name":"\uc0ac\uc774\ubc84\ub124\ud2f1 \uc18d\ub3c4","description":"\uc218\ub9ac\uac80\uc73c\ub85c \ud53c\ud574\ub97c \uc8fc\uba74 3\ucd08 \ub3d9\uc548 \uc218\ub9ac\uac80 \uacf5\uaca9 \uc18d\ub3c4\uac00 3% \uc99d\uac00\ud569\ub2c8\ub2e4(\ucd5c\ub300 15\ud68c \uc911\ucca9).","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/32abd8a6c5989ddb8a01ac80cb497ef3a2894f9d4e726647d0ca4087892daa02.png"},{"name":"\uc6a9\uc758 \uc544\uac00\ub9ac","description":"\uc218\ub9ac\uac80 \ud53c\ud574\ub97c \uc8fc\uba74 \ub2e4\uc74c \uc9c8\ud48d\ucc38 \ud53c\ud574\uac00 10%, \uc0ac\uac70\ub9ac\uac00 5% \uc99d\uac00\ud569\ub2c8\ub2e4(\ucd5c\ub300 5\ud68c \uc911\ucca9).","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/ddfaf3f3d72fa4fa0d1bebf3182de630a774217555a8ec6718bc8cd8006e6f74.png"},{"name":"\uac70\ud569 \ubca0\uae30","description":"\ud295\uaca8\ub0b4\uae30\uac00 \ub05d\ub098\uba74 \uc6a9\uac80\uc744 75%\uc758 \ud6a8\uc728\ub85c \uc7ac\ube60\ub974\uac8c \ud55c \ubc88 \ud718\ub450\ub985\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/e04ec03f8c11222d97d96158425e68eed88863b54bde5c0423017252b332c41d.png"},{"name":"\uc228\uaca8\uc9c4 \uce7c\ub0a0","description":"60%\uc758 \uadfc\uc811 \uacf5\uaca9 \uc0dd\uba85\ub825 \ud761\uc218\ub97c \uc5bb\uace0, \ube60\ub978 \uadfc\uc811 \uacf5\uaca9 \ud53c\ud574\uac00 15 \uc99d\uac00\ud569\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/e0ac7af317bdf42cbcba2867a9e492a66895bee10580ffed7789d169ade2c56e.png"},{"name":"\ubd88\ub85c \ubcbc\ub9b0 \uac83","description":"\ud295\uaca8\ub0b4\uae30\uac00 \ud65c\uc131\ud654\ub418\uc5b4 \uc788\uc744 \ub54c, \ud295\uaca8\ub0b4\uae30\ub85c \ub9c9\uc740 \ud53c\ud574\uc758 100%\ub9cc\ud07c \uce58\uc720\ud569\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/6da8104fd4267ac8dbacd0de91fa71e946c8e312efd591f66ff3e5f35a801d9b.png"},{"name":"\uc5f4\uc0c1","description":"\uc9c8\ud48d\ucc38\uc774 3\ucd08\uc5d0 \uac78\uccd0 30%\uc758 \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\u00ad\u00a0\uccab \ub300\uc0c1 \uc774\ud6c4 \ucd94\uac00 \uc801 \ud558\ub098\uc5d0\uac8c \uc9c8\ud48d\ucc38\uc73c\ub85c \ud53c\ud574\ub97c \uc904 \ub54c\ub9c8\ub2e4 \uc9c8\ud48d\ucc38 \uc7ac\uc0ac\uc6a9 \ub300\uae30\uc2dc\uac04\uc774 2.5\ucd08\uc529 \uac10\uc18c\ud569\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/b123983dc94de25a8585bfbecf8ecbc592fd60a925632bae5422d0647a029308.png"},{"name":"\ud295\uaca8\ub0b4\uae30\ubd07","description":"\ud295\uaca8\ub0b8 \ud22c\uc0ac\uccb4 \uc18d\ub3c4 +200%\u00ad\u00a0\uc801\uc5d0\uac8c \uc790\ub3d9\uc73c\ub85c \ud22c\uc0ac\uccb4\ub97c \ud295\uae41\ub2c8\ub2e4. \ud295\uaca8\ub0b4\uae30 \uccab 0.3\ucd08 \ub3d9\uc548 \ud295\uaca8\ub0b8 \uacf5\uaca9\uc774 50%\uc758 \ucd94\uac00 \uce58\uba85\ud0c0 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/777239b5a2be3033c95daced0dcada23ecb3cd061cdd78e6f08cdee95e93a90b.png"},{"name":"\ud558\uc2dc\ubaa8\ud1a0\uc758 \ud30c\uba78","description":"\uae30\uc220 \uc0ac\uc6a9 \ud6c4 \ub2e4\uc74c \ubcf4\uc870 \ubc1c\uc0ac \uc2dc \uc218\ub9ac\uac80\uc744 2\uac1c \ucd94\uac00\ub85c \ub358\uc9d1\ub2c8\ub2e4. \uc774 \uc218\ub9ac\uac80\uc740 \uc801\uc744 \ucd94\uc801\ud558\uc9c0\ub9cc \ud53c\ud574\ub7c9\uc774 50% \uac10\uc18c\ud569\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/0ec96860c9d8012a53f626c94aebd2c19938782fba4d325933513876cfb654d8.png"},{"name":"\uc6a9\uc758 \uc228\uacb0","description":"\uc6a9\uac80\uc744 \ud718\ub450\ub974\uba74 \uc6a9\uac80 \ud53c\ud574\uc758 100%\ub9cc\ud07c \ud53c\ud574\ub97c \uc8fc\ub294 \uac70\ub300\ud55c \uad00\ud1b5 \ud22c\uc0ac\uccb4\ub97c \ubc1c\uc0ac\ud569\ub2c8\ub2e4. \uacf5\uc911\uc5d0 \ub72c \uc801\uc5d0\uac8c\ub294 25%\uc758 \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/775a926133c6c037df6d54a278663ec8798a6a5455bb1f4eb8387b7058d83cd6.png"},{"name":"\uc18c\uc9c0\ub85c\uc758 \uc601\ud63c","description":"\ud295\uaca8\ub0b4\uae30 \uc9c0\uc18d \uc2dc\uac04 +1\ucd08\u00ad\u00a0\ud295\uaca8\ub0b4\uae30\uac00 \uc774\uc81c \uc591\ucabd \uacf5\uaca9\uc744 \ubaa8\ub450 \ud295\uaca8\ub0c5\ub2c8\ub2e4.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/69dd84b758c336eee4b009b068b217b8c9e0103d41b6357a83382926b7c97267.png"}]}