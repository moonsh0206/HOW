# REVIEW-ONLY DRAFT. Outside .github/workflows: cannot run or enable a schedule.
# After approval: pin upload-artifact to a reviewed commit SHA before activation.
name: Reviewable HOW statistics snapshot
on:
  workflow_dispatch:
  # schedule:
  #   - cron: '17 */6 * * *' # UTC, every 6h; enable only after explicit approval
permissions:
  contents: read
concurrency:
  group: how-snapshot-collection
  cancel-in-progress: false
jobs:
  collect:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020
        with:
          node-version: '24'
          cache: npm
      - run: npm ci
      - run: npm test
      - run: npm run snapshots:collect
      - uses: actions/upload-artifact@v7
        with:
          name: how-statistics-snapshots
          path: public/data/snapshots/*.json
          retention-days: 30
          if-no-files-found: error
# Artifact-only: a human reviews/copies files and approves publication separately.
# This draft does not commit, push, create PRs, or deploy Pages.
