-contentstack-assets.akamaized.net/v3/assets/blt2477dcaf4ebd440c/bltb123915a4cddc0cd/69864d9befc72d1cca137602/Anran_VermillionAscent_MP4_GH_01.mp4","webm":"https://blz-contentstack-assets.akamaized.net/v3/assets/blt2477dcaf4ebd440c/bltcda5a15e4e0a2404/69864d73196624e597aeff3f/Anran_VermillionAscent_MP4_GH_01.webm"}}},{"name":"朱魂返","description":"デス時に発動することで、爆発とともに自己蘇生する","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/9060d9e2e407a31ab95948e6512373a4318ebd8883aefa91e9f2fa9bbffb7076.png","video":{"thumbnail":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/blt1fd77f77129c77bb/698174c2f50df30a22469407/VermillionRevival.png","link":{"mp4":"https://blz-contentstack-assets.akamaized.net/v3/assets/blt2477dcaf4ebd440c/blt3c407aa44c71e406/69864d927c6e2ca98d5e0b06/Anran_VermillionRevival_MP4_GH_01.mp4","webm":"https://blz-contentstack-assets.akamaized.net/v3/assets/blt2477dcaf4ebd440c/bltcda5a15e4e0a2404/69864d73196624e597aeff3f/Anran_VermillionAscent_MP4_GH_01.webm"}}},{"name":"焚身焔","description":"炎の攻撃で敵を炎上させる","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/f4a70d5eacbfa0f6e8290ad352df6e06e72e5dc755ecc650e120697bf59fa7ad.png","video":{"thumbnail":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/blt5d221d0eb4fb16ba/6986416e3101f347885613a2/Ignition.png","link":{"mp4":"https://blz-contentstack-assets.akamaized.net/v3/assets/blt2477dcaf4ebd440c/blt797235297f8d43b5/69864121f2d218edf88ef92c/0204_S21-HeroWebAbilityPage_ANRAN_Passive-Ignition_100_4K_PRHQ_LIVE_BEST_MZ.mp4","webm":"https://blz-contentstack-assets.akamaized.net/v3/assets/blt2477dcaf4ebd440c/bltd7a9d2276e5799e6/69864cd3e36e665316c1a708/0204_S21-HeroWebAbilityPage_ANRAN_Passive-Ignition_100_4K_PRHQ_LIVE_BEST_MZ.webm"}}}],"perks":{"minor":[{"name":"燻火","description":"敵の炎上が1.5秒長く続く","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/5d927315af0a5729ab1be838556dc1e2d9206bbe0fd69bf3c084b64a761c9b12.png"},{"name":"炎鎧","description":"アルティメット発動時と、同アビリティで炎上した敵が1人カウントされるごとに、50の追加ライフを得る","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/52a35ec19286d15384a73910c2763d02774674069f3cfd0ee5681afd545f3c82.png"}],"major":[{"name":"怒火","description":"〈怒炎衝〉が敵にヒットすると、同アビリティのクールダウンが1.5秒減る","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/6aedcee19eff304025cefdba8f089cf356293389088f53c8c6f4de11a008ba63.png"},{"name":"烈火","description":"〈熠閃舞〉の連続ヒットで得られる回復量が25増える","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/110e0b00345b359281b3ae871725d149051bed40fce266435806b4c390729722.png"}]},"story":{"summary":"イェ・アンランは両親と同じ五行大学火学部に進み、同学を首席で卒業したオーバーウォッチの新エージェントだ。彼女の戦士としての真価が今、世界をかけた新たな戦いで試されようとしている。","media":{"type":"video","link":"https://youtu.be/_L6ZJnHmFzY"},"chapters":[{"title":"比類なき俊才","content":"幼くして優れた才を見せてきたアンランは、両親の高い期待の中で育った。3歳にして勉学とカンフーの稽古を始め、その後十分に成長すると、武術太極拳と中国古典舞踊の稽古も開始。生傷の絶えない修行の日々も相まって、舞踊の大会では記録更新を毎年重ねるなど、比類なき強さを発揮し、表彰台を逃すことは一度もなかった。輝かんばかりの実績を舞踊界で築き上げるアンランだったが、進学を前にして、舞踊は今後趣味として続けると宣言。競技の場を離れ、武術の修行に集中するため五行大学火学部に入学した。","picture":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/blt431ef9134c51e987/698641f4f50df3a64b46960f/anran1.png"},{"title":"姉として","content":"アンランには両親から多大な期待と責任が寄せられていたが、3歳下の弟であるウーヤンを鍛え上げることも彼女の役目だった。たった1人の姉として、弟を教え、導き、守ること――幾度となく両親から言われた言葉どおりに、彼女は弟の面倒をよく見た。ウーヤンが期待通りの成果を上げられない時、アンランは指南役である自分の責任だとして彼をかばい、しばしば両親と衝突した。弟の至らなさは姉である自分の過失だとアンランは考えていたのだ。それゆえに、ウーヤンが五行大学水学部に合格すると、彼女は心から喜んだが、自らの足で己の道を歩み出した弟に対し、もはや自分の手は必要ないのだと、心のどこかで喪失感を覚えるのだった。","picture":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/blt993d46a924958d59/69d6e1f7d3c1c9fb05f09d73/OVR_S21_Web_Anran_006_1.png"},{"title":"五行大学 - 火学部","content":"アンランが進学した五行大学火学部は、武道の観点から中国最高峰の軍事専門家を育成することを目的とした学部だ。彼女はこの学部の期待の星、目指すべき模範として学生たちの信望を集めると同時に、その非凡さから畏れられた。ゆえに、彼女の厳しくも的確な指摘に耐えられる同窓は限られていたが、そうした者たちは彼女と共に大きく成長し、アンランもまた、努力を重ねる仲間を決して見捨てることなく支えた。 ヌルセクターによる成都襲撃が発生すると、正規軍が到着するまで一般市民の避難を支援すべく、アンランも火学部学生小隊の一員として出撃した。途中、仲間が退却する時間を稼ぐために、単独でヌルセクターと交戦して窮地に追い込まれる場面もあったが、それを聞きつけたウーヤンが救援に現れると、2人は姉弟ならではの息の合った連携を披露。ヌルセクターの包囲を突破して生還を果たした。この活躍がオーバーウォッチの目に止まり、アンランとウーヤンはその後、姉弟揃って同組織からスカウトされることとなる。","picture":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/blt0d5df17f37fe988d/69d6e22228a69c6d3e0f5c2b/anran3.png"},{"title":"タロン侵攻","content":"アンランの大学卒業後、ウォッチポイント・ジブラルタルへと旅立った姉弟だったが、基地で待ち受けていたのは、オーバーウォッチの面々による温かい歓迎ではなく、タロンの急襲だった。ウーヤンとともに否応なく戦闘に身を投じることになったアンランは、混迷を極める時代のうねりを前に、オーバーウォッチのヒーローとして戦う決意を新たにするのだった。","picture":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/bltf8ebeac5659e26aa/69864239e7959c7b85bb36a9/talon_lore.png"}]}}