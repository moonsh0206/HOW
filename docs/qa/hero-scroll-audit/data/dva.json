{"name":"D.Va","description":"프로게이머 출신인 D.Va는 이제 뛰어난 실력으로 최첨단 메카를 조종하며 조국을 수호합니다.","backgrounds":[{"url":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/blt263fecc338db9cc3/631a8b650e1b4f0e7b89a534/960_Dva.jpg","sizes":["min","xs","sm"]},{"url":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/bltf8e9415141b0ec36/631a8b65e7bdcf0dd996c8e1/1600_Dva.jpg","sizes":["md","lg"]},{"url":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/bltcd4bcf30a5794639/631a8b65f581050de0035df6/2600_Dva.jpg","sizes":["xl+"]}],"portrait":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/df5a5532862d9292634fb3dc0e51a4705aa601de65e5e815513ccc663d84de56.png","role":"tank","subrole":"initiator","location":"대한민국, 부산, MEKA 기지(이전 기록), 감시 기지: 지브롤터","birthday":"6월 22일","age":21,"hitpoints":{"shields":0,"health":350,"armor":325,"total":675},"abilities":[{"name":"융합포","description":"근거리에 방사 피해를 주는 연발포입니다.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/1b8dd81bd8353ce0a66009578dc4d7b6a51464e5bc7898010053ff46159f4fa1.png","video":{"thumbnail":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/bltdfafff3f6e7da8bb/6339051eec7e18758be5104a/DVA_FUSIONCANNON.jpg","link":{"mp4":"https://blz-contentstack-assets.akamaized.net/v3/assets/blt2477dcaf4ebd440c/bltbab346e856582d6b/633905181ccd046877c0e4e3/OVERWATCH_WEBSITE_CHARACTER_CAPTURE_DVaFusionCannons_WEB_16x9_1920x1080p30_H264.mp4","webm":"https://blz-contentstack-assets.akamaized.net/v3/assets/blt2477dcaf4ebd440c/blt0cf1edda6843f5e5/669ea472826d2a05c8d5849d/OVERWATCH_WEBSITE_CHARACTER_CAPTURE_DVaFusionCannons_WEB_16x9_1920x1080p30_WEBM.webm"}}},{"name":"광선총","description":"자동 권총입니다.","icon":"https://d15f34w2p8l1cc.cloudfront.net/overwatch/969a72050f376bf6ee5ed5550a8033cdd661f2f9883c1229e9ee70dd3ae58ec4.png","video":{"thumbnail":"https://blz-contentstack-images.akamaized.net/v3/assets/blt2477dcaf4ebd440c/blt686e78b1c55884b8/6339051e1ccd046877c