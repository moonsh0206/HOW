      "decoded": "# Local implementation; remains disabled until HOW_RANKS_ENABLED=true.\nname: Lightweight daily role ranks\non:\n  workflow_dispatch:\n  schedule:\n    - cron: '0 1 * * *'\npermissions:\n  contents: read\nconcurrency:\n  group: pages\n  cancel-in-progress: false\njobs:\n  publish:\n    if: vars.HOW_RANKS_ENABLED == 'true' && github.ref == 'refs/heads/main'\n    runs-on: ubuntu-latest\n    timeout-minutes: 20\n    permissions:\n      contents: read\n      pages: write\n      id-token: write\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020\n        with:\n          node-version: '24'\n          cache: npm\n      - run: npm ci\n      - name: Restore durable graph observations when enabled\n        if: vars.HOW_GRAPH_ARCHIVE_ENABLED == 'true'\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: node scripts/graph-archive.js restore\n      - name: Restore successful publication and compute in memory\n        env:\n          RANKS_URL: ${{ vars.HOW_RANKS_URL }}\n        run: node scripts/collect-daily-ranks.js --apply --restore-url \"$RANKS_URL\"\n      - run: npm test\n      - uses: actions/configure-pages@45bfe0192ca1faeb007ade9deae92b16b8254a0d\n        id: pages\n      - run: npm run build\n        env:\n          VITE_BASE_PATH: ${{ steps.pages.outputs.base_path }}/\n      - run: npm run verify:pages\n        env:\n          VITE_BASE_PATH: ${{ steps.pages.outputs.base_path }}/\n      - name: Refuse publication if main changed during collection\n        run: |\n          git fetch origin main\n          test \"$(git rev-parse HEAD)\" = \"$(git rev-parse origin/main)\"\n      - uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9\n        with:\n          path: dist\n      - uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346\n        id: deployment\n      - name: Record confirmed publication time only after successful deployment\n        env:\n          DEPLOYED_URL: ${{ steps.deployment.outputs.page_url }}\n          RANKS_URL: ${{ vars.HOW_RANKS_URL }}\n        run: node scripts/verify-rank-publication.js\n      - uses: actions/upload-artifact@v4\n        with:\n          name: confirmed-rank-publication\n          path: rank-publication.json\n          retention-days: 7\n"
    }
  },
